@page "/catalogo"

<div class="flex items-center justify-center border-2 flex-col w-10vw h-10vw p-4 m-2">
@foreach (Cafe cafe in lstcafes)
{
    <div>
        <img src="@cafe.Imagen" class="w-full h-full object-cover"/>
        <h2>@cafe.NombreCafe</h2>
        <p>@cafe.DescripcionCafe</p>
        <p class="font-bold text-white bg-green-600 rounded-xl p-3">@cafe.PrecioCafe Bs</p>
    </div>
}
</div>

