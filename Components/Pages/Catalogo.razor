@page "/catalogo"
@using sharpness_sharp.Components.UIComponents
@using sharpness_sharp.Data
@using sharpness_sharp.Data.Models
@inject ApplicationAuthDbContext _dbService
 
<EditForm FormName="agregar-cafe" Model="@newCafe" OnSubmit="AgregarCafe">
    <InputText @bind-Value="newCafe.Imagen" class="border-2 px-2" placeholder="introduce la url de la imagen"/>
    <InputText @bind-Value="newCafe.NombreCafe" class="border-2 px-2" placeholder="introduce el nombre del cafe"/>
    <InputText @bind-Value="newCafe.DescripcionCafe" class="border-2 px-2" placeholder="introduce la descripcion del cafe"/>
    <InputNumber @bind-Value="newCafe.PrecioCafe" class="border-2 px-2" placeholder="introduce el precio del cafe"/>
 
    <button type="submit">Guardar</button>
</EditForm>
 
<div class="min-h-screen bg-gradient-to-br from-stone-50 via-amber-50/40 to-stone-100 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    @foreach (Cafe cafe in lstCafes)
    {
        <CofeeCard Imagen="@cafe.Imagen" NombreCafe="@cafe.NombreCafe" DescripcionCafe="@cafe.DescripcionCafe" PrecioCafe="@cafe.PrecioCafe"></CofeeCard>
    }
    </div>
</div>

 
@code {
    private Cafe newCafe = new();
    private List<Cafe> lstCafes = new();
    protected override Task OnInitializedAsync()
    {
        lstCafes = _dbService.Cafes.ToList();
        return base.OnInitializedAsync();
    }
    private Task AgregarCafe()
    {
        _dbService.Cafes.Add(newCafe);
        _dbService.SaveChanges();
        newCafe = new();
        return Task.CompletedTask;
    }
}