@page "/usuario"
@using sharpness_sharp.Components.UIComponents
@using sharpness_sharp.Data
@inject ApplicationAuthDbContext _dbService


<div class="flex flex-col gap-2">
    @foreach (ApplicationUser user in lstUsuarios)
    {
        <div class="w-fit border-2 rounded-md p-4 m-2 ">
            <h2>Username: @user.UserName</h2>
            <p>Email: @user.Email</p>
        </div>
    }
</div>

@code{
    public List<ApplicationUser> lstUsuarios = new List<ApplicationUser>();
    protected override Task OnInitializedAsync()
    {
        lstUsuarios = _dbService.Users.ToList();
        return base.OnInitializedAsync();
    }

}